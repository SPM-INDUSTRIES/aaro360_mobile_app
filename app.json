{
  "expo": {
    "name": "Aaro360",
    "slug": "aaro360-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appicon/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aaro360.app"
    },
    "android": {
      "minSdkVersion": 24,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "adaptiveIcon": {
        "foregroundImage": "./assets/appicon/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.aaro360.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC7AiyMkoTq5KCtQWBrvGeYAdboqRzGwyQ"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Aaro360 to use your location for delivery tracking."
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "aaro360",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2c6b3657-2326-4bea-9d19-83af5375dfc3"
      }
    }
  }
}
{
  "expo": {
    "name": "Aaro360",
    "slug": "aaro360",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appicon/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aaro360.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Aaro360 uses your photo library to let you set a profile picture for your account.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "minSdkVersion": 24,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "adaptiveIcon": {
        "foregroundImage": "./assets/appicon/icon.png",
        "backgroundColor": "#fa6521"
      },
      "package": "com.aaro360.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC7AiyMkoTq5KCtQWBrvGeYAdboqRzGwyQ"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Aaro360 to use your location for delivery tracking."
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "aaro360",
    "updates": {
      "url": "https://u.expo.dev/817b2097-c556-449f-8175-9da1f0617160"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "817b2097-c556-449f-8175-9da1f0617160"
      }
    },
    "owner": "spmindustriess-organization"
  }
}
